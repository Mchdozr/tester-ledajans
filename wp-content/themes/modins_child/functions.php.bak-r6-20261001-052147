    if ($done || $context !== 'the_content' || is_admin() || !is_page(array(4969, 4992))) { return $tag; }
    $done = true; // yalnızca sayfadaki İLK içerik görseli
    $tag = preg_replace('#\sloading=(["\'])lazy\1#i', '', $tag);
